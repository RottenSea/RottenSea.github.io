---
import "@rottensea/ds-personal-website/index.css";
import "@rottensea/ds-personal-website/page-transitions.css";
import {
  FloatingControls,
  Fonts,
  Footer,
  IconButton,
  SearchPanel,
  SettingsMenu,
  SkipLink,
  Starfield,
  ThemeScript,
  TopNav
} from "@rottensea/ds-personal-website/components";
import "../styles/prose.css";
import {
  FOOTER_COLUMNS,
  MOTION_STORAGE_KEY,
  NAV,
  NEW_TAB_NOTE,
  POST_LICENSE,
  pagePath,
  SITE_DESCRIPTION,
  SITE_TITLE,
  THEME_STORAGE_KEY
} from "../utils/site";

interface Props {
  /** The page's own title. Leave it out on the home page. */
  title?: string;
  description?: string;
  /** The nav floats over a full-height band in the `hero` slot until the page scrolls. */
  overlayNav?: boolean;
  /** The main column runs to the grid's width, for a page with rails. */
  wide?: boolean;
  /** The share card's image at 1200:630: a path on this site. Without one, the site's own. */
  image?: string;
  /** The image's size in px, when it is not the site's own 1200 by 630. */
  imageSize?: { width: number; height: number };
  /** `article` for a post, with its dates as ISO instants. */
  article?: { published: string; modified: string; tags: string[] };
  /** Structured data for search engines: one schema.org object or several. */
  jsonLd?: object | object[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  overlayNav = false,
  wide = false,
  image = "/og.png",
  imageSize = { width: 1200, height: 630 },
  article,
  jsonLd
} = Astro.props;
const fullTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const path = pagePath(Astro.url);
const active = NAV.find((item) => item.matches(path))?.label;
const links = NAV.map(({ label, href }) => ({ label, href }));
const canonical = new URL(path, Astro.site).href;
// JSON in a <script> ends at the first "</script", so "<" is written as an escape.
const structured = jsonLd && JSON.stringify(jsonLd).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    {/* The card a link shows when it is shared: Open Graph, which X reads too. */}
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site).href} />
    <meta property="og:image:width" content={String(imageSize.width)} />
    <meta property="og:image:height" content={String(imageSize.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published} />
          <meta property="article:modified_time" content={article.modified} />
          {article.tags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }
    {structured && <script type="application/ld+json" set:html={structured} />}
    {/* Sets data-theme before the first paint: the reader's choice, or else the OS setting. */}
    <ThemeScript storageKey={THEME_STORAGE_KEY} motionKey={MOTION_STORAGE_KEY} />
    {/*
      The design system's CSS loads no fonts. Fonts connects early to Google Fonts and jsDelivr and
      loads their stylesheets without holding up the page: text shows at once in the fallback
      fonts, and each part of a font swaps in as it arrives.
    */}
    <Fonts />
  </head>
  <body>
    {/* The sky every page floats on, as in the handoff: fixed to the window, under everything. */}
    <Starfield />
    <SkipLink />
    <TopNav brand={SITE_TITLE} links={links} active={active} overlay={overlayNav}>
      <IconButton slot="actions" icon="search" label="Search" data-ds-search-open="site-search" />
      <SettingsMenu slot="actions" storageKey={THEME_STORAGE_KEY} motionKey={MOTION_STORAGE_KEY} />
    </TopNav>
    <slot name="hero" />
    <main id="main" class:list={["site-main", { "site-main--wide": wide }]}>
      <slot />
    </main>
    <Footer brand={SITE_TITLE} columns={FOOTER_COLUMNS}>
      <Fragment slot="note">
        © 2026 RottenTh. Posts are licensed under
        <a class="ds-external" href={POST_LICENSE.href} target="_blank" rel="license noreferrer"
          >{POST_LICENSE.name}<span class="ds-visually-hidden">{NEW_TAB_NOTE}</span></a
        >.
      </Fragment>
    </Footer>
    <SearchPanel id="site-search" />
    <FloatingControls>
      <slot name="controls" />
    </FloatingControls>
  </body>
</html>

<script>
  import "../scripts/search";
</script>

<style>
  /* A page shorter than the window still ends with the footer at the bottom edge. dvh follows a
     phone's address bar as it shows and hides, so the footer stays on the edge either way. */
  :global(body) {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  :global(body > .ds-footer) {
    margin-top: auto;
  }

  /* One reading column, or the grid's width for a page with rails. The width is set because a
     flex item with auto side margins would otherwise shrink to its content. */
  .site-main {
    margin-inline: auto;
    max-width: 42.5rem;
    padding: var(--space-xl) var(--space-lg) var(--space-section);
    width: 100%;
  }

  .site-main--wide {
    max-width: none;
  }
</style>
