---
import { getImage } from "astro:assets";
import { render } from "astro:content";
import {
  Comments,
  ContentGrid,
  components,
  Figure,
  PostLicense,
  PostMeta,
  PostNav,
  PostShare,
  SidebarCard,
  TagList,
  TocButton,
  TocList,
  ViewCount
} from "@rottensea/ds-personal-website/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { cardSize } from "../../utils/images";
import {
  getAllPosts,
  getPosts,
  type Post,
  postDates,
  postSlug,
  postUrl
} from "../../utils/posts";
import { countWords, readingMinutes } from "../../utils/reading";
import {
  AUTHOR,
  COMMENT_SERVER,
  filterUrl,
  NEW_TAB_NOTE,
  POST_LICENSE,
  SITE_TITLE
} from "../../utils/site";

export async function getStaticPaths() {
  // By publication time, ignoring pins; a draft is in no list, so it has no neighbours.
  const byTime = (await getPosts()).toSorted((a, b) =>
    postDates(a).published.localeCompare(postDates(b).published)
  );
  const link = (post?: Post) =>
    post && {
      title: post.data.title,
      href: postUrl(post),
      lang: post.data.lang
    };
  return (await getAllPosts()).map((post) => {
    const index = byTime.indexOf(post);
    return {
      params: { slug: postSlug(post) },
      props: {
        post,
        older: index < 0 ? undefined : link(byTime[index - 1]),
        newer: index < 0 ? undefined : link(byTime[index + 1])
      }
    };
  });
}

interface PostLink {
  title: string;
  href: string;
  lang: string;
}

interface Props {
  post: Post;
  older?: PostLink;
  newer?: PostLink;
}

const { post, older, newer } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const { published, publishedDate, updated, updatedDate, revisions } =
  postDates(post);
const toc = headings
  // The footnotes' heading is for screen readers only.
  .filter((heading) => heading.slug !== "footnote-label")
  .map((heading) => ({
    id: heading.slug,
    text: heading.text,
    level: heading.depth
  }));
const hasToc = toc.some((item) => item.level === 2 || item.level === 3);
const meta = [
  { label: publishedDate, datetime: published },
  ...(data.category
    ? [{ label: data.category, href: filterUrl("category", data.category) }]
    : []),
  `${readingMinutes(countWords(post.body ?? ""))} min`,
  ...(revisions > 0 ? [`Revision ${revisions}`] : [])
];
const url = new URL(postUrl(post), Astro.site).href;
// Keyed by folder name, so a new permalink keeps the comments and view count.
const commentPath = `/blog/${post.id}`;
// The share poster draws the cover at 1080px wide.
const cover =
  data.image && (await getImage({ src: data.image, width: 1080 })).src;
// The share card's cover is cut to 1200:630; Astro never enlarges, so a small cover is cut smaller.
const shareSize = data.image && cardSize(data.image.width, data.image.height);
const shareImage =
  data.image && shareSize
    ? (
        await getImage({
          src: data.image,
          ...shareSize,
          fit: "cover",
          format: "jpg"
        })
      ).src
    : "/og.png";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: data.title,
  description: data.description,
  url,
  mainEntityOfPage: url,
  datePublished: published,
  dateModified: updated,
  inLanguage: data.lang === "zh" ? "zh-CN" : "en",
  image: new URL(shareImage, Astro.site).href,
  keywords: data.tags,
  ...(data.category ? { articleSection: data.category } : {}),
  author: {
    "@type": "Person",
    name: AUTHOR,
    url: new URL("/about", Astro.site).href
  },
  license: POST_LICENSE.href
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  wide
  image={shareImage}
  imageSize={shareSize}
  article={{ published, modified: updated, tags: data.tags }}
  jsonLd={jsonLd}
  noindex={data.draft}
>
  <ContentGrid stackRails="none" mainWidth="var(--container-reading)" class="post-grid">
    {/* Search indexes the title, text and tags; drafts are left out. */}
    <article
      class="post"
      lang={data.lang}
      data-pagefind-body={data.draft ? undefined : ""}
    >
      {/* What the search results show under the title. */}
      <span hidden data-pagefind-meta={`date:${publishedDate}`}></span>
      {data.category && <span hidden data-pagefind-meta={`category:${data.category}`}></span>}
      <header class="post__header">
        <div lang="en" data-pagefind-ignore><PostMeta size="md" items={meta}>
          <ViewCount server={COMMENT_SERVER} path={commentPath} title={data.title} />
        </PostMeta></div>
        <h1 class="post__title">{data.title}</h1>
      </header>

      {data.image && <Figure src={data.image} alt="" zoom={false} loading="eager" sizes="(min-width: 720px) 680px, 100vw" class="post__cover" />}

      <div class="prose">
        <Content components={components} />
      </div>

      <footer class="post__end" lang="en">
        {
          data.tags.length > 0 && (
            <TagList items={data.tags.map((tag) => ({ label: tag, href: filterUrl("tag", tag) }))} />
          )
        }
        <div class="post__more" data-pagefind-ignore>
        <PostLicense
          title={data.title}
          href={url}
          author={AUTHOR}
          published={{ label: publishedDate, datetime: published }}
          updated={updated && updatedDate !== publishedDate ? { label: updatedDate ?? "", datetime: updated } : undefined}
          license={POST_LICENSE}
          lang={data.lang}
          newTabNote={NEW_TAB_NOTE}
        />
        <PostShare
          title={data.title}
          description={data.description}
          url={url}
          site={SITE_TITLE}
          date={publishedDate}
          cover={cover}
          filename={postSlug(post)}
        />
        <PostNav prev={older} next={newer} />
        </div>
      </footer>

      {data.comment && (
        <div data-pagefind-ignore>
          <Comments server={COMMENT_SERVER} path={commentPath} />
        </div>
      )}
    </article>

    {
      hasToc && (
        <Fragment slot="right">
          <SidebarCard title="On this page">
            <TocList items={toc} maxHeight="calc(100vh - 12rem)" />
          </SidebarCard>
        </Fragment>
      )
    }
  </ContentGrid>

  {hasToc && <TocButton slot="controls" items={toc} />}
</BaseLayout>

<style>
  .post {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    max-width: var(--container-reading);
    min-width: 0;
  }

  .post__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .post__title {
    color: var(--text-ink);
    font-family: var(--display-lg-family);
    font-size: var(--display-lg-size);
    font-weight: var(--display-lg-weight);
    letter-spacing: var(--display-lg-ls);
    line-height: var(--display-lg-lh);
    text-wrap: pretty;
  }

  /* The cover is the top of the post, so it has no caption gap under it. */
  .post :global(.post__cover) {
    margin: 0;
  }

  /* Out of the search index, but laid out as part of the end matter. */
  .post__more {
    display: contents;
  }

  .post__end {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  @media (max-width: 768px) {
    .post__title {
      font-size: var(--display-md-size);
      letter-spacing: var(--display-md-ls);
      line-height: var(--display-md-lh);
    }
  }
</style>
