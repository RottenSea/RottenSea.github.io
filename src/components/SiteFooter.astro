---
// The uptime counter from the old site. It moves to the sidebar's stats card once there is a
// sidebar; the footer will then hold the copyright, licence and RSS links.
---

<footer class="site-footer">
  uptime <span class="uptime" data-uptime>--</span>
</footer>

<script>
  /** When the site went live: 2026-05-20 10:49:12 UTC+8. */
  const LAUNCHED_AT = Date.parse("2026-05-20T02:49:12Z");

  const pad = (n: number) => String(n).padStart(2, "0");

  function format(elapsed: number): string {
    if (elapsed < 0) return "not yet";
    const seconds = Math.floor(elapsed / 1000);
    const days = Math.floor(seconds / 86400);
    const clock = `${pad(Math.floor((seconds % 86400) / 3600))}:${pad(Math.floor((seconds % 3600) / 60))}:${pad(seconds % 60)}`;
    return days > 0 ? `${days}d ${clock}` : clock;
  }

  // The built HTML says "--": the time is only known in the browser.
  const output = document.querySelector<HTMLElement>("[data-uptime]");
  if (output) {
    const update = () => {
      output.textContent = format(Date.now() - LAUNCHED_AT);
    };
    update();
    setInterval(update, 1000);
  }
</script>

<style>
  .site-footer {
    color: var(--text-muted-soft);
    font-family: var(--body-sm-family);
    font-size: var(--body-sm-size);
    line-height: var(--body-sm-lh);
    margin-top: var(--space-section);
    padding: var(--space-xl);
    text-align: center;
  }

  .uptime {
    font-family: var(--font-mono);
  }
</style>
