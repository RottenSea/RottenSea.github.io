---
import { NAV, pagePath } from "../utils/site";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const current = NAV.find((item) => item.matches(pagePath(Astro.url)))?.href;
---

<header class="site-header">
  <a class="site-title" href="/">{title}</a>
  <nav class="site-nav" aria-label="Site">
    {
      NAV.map((item) => (
        <a href={item.href} aria-current={item.href === current ? "page" : undefined}>
          {item.label}
        </a>
      ))
    }
    <ThemeToggle />
  </nav>
</header>

<style>
  .site-header {
    align-items: center;
    border-bottom: var(--border-hairline);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: space-between;
    margin-bottom: var(--space-xxl);
    padding-bottom: var(--space-md);
  }

  .site-title {
    color: var(--text-ink);
    font-family: var(--title-md-family);
    font-size: var(--title-md-size);
    font-weight: var(--title-md-weight);
    line-height: var(--title-md-lh);
    letter-spacing: var(--title-md-ls);
    text-decoration: none;
  }

  .site-nav {
    align-items: center;
    display: flex;
    gap: var(--space-md);
  }

  .site-nav a {
    color: var(--text-muted);
    text-decoration: none;
    transition: var(--transition-tint);
  }

  .site-nav a:hover,
  .site-nav a[aria-current="page"] {
    color: var(--text-ink);
  }

  .site-nav a[aria-current="page"] {
    text-decoration-line: underline;
  }
</style>
