---
import "@rottensea/ds-personal-website/index.css";
import { Fonts } from "@rottensea/ds-personal-website/components";
import "../styles/prose.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { pagePath, THEME_STORAGE_KEY } from "../utils/site";

interface Props {
  /** The page's own title. Leave it out on the home page. */
  title?: string;
  description?: string;
}

const SITE_TITLE = "The Key of Urala";
const { title, description = "欢迎来到 RottenTh 的咖啡角~" } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(pagePath(Astro.url), Astro.site)} />
    {/*
      Runs before the first paint so the page never flashes the other theme first. The design
      system's CSS reads only data-theme, so this always sets it: the saved choice, or else the OS
      setting. is:inline keeps Astro from bundling it into a deferred module.
    */}
    <script is:inline define:vars={{ key: THEME_STORAGE_KEY }}>
      let theme;
      try {
        theme = localStorage.getItem(key);
      } catch {}
      if (theme !== "light" && theme !== "dark") theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      document.documentElement.dataset.theme = theme;
    </script>
    {/*
      The design system's CSS loads no fonts. Fonts connects early to Google Fonts and jsDelivr and
      loads their stylesheets without holding up the page: text shows at once in the fallback
      fonts, and each part of a font swaps in as it arrives.
    */}
    <Fonts />
  </head>
  <body>
    <div class="site">
      <SiteHeader title={SITE_TITLE} />
      <main>
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

<style>
  .site {
    margin-inline: auto;
    max-width: 42.5rem;
    padding-inline: var(--space-lg);
    padding-block: var(--space-xl) calc(var(--space-xl) * 2);
  }
</style>
