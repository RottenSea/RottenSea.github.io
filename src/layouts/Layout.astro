---
import "@/styles/global.css";
import "@/styles/normalize.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  title?: string;
}

const { title = "RottenTh's cafe corner" } = Astro.props;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <title>{title}</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <Font cssVariable="--font-noto-serif-sc" />
    <Font cssVariable="--font-source-han-sans-sc" />
    <Font cssVariable="--font-maple-mono" />
    <ClientRouter />
    <script is:inline>
      (function () {
        var STORAGE_KEY = "theme-preference";
        var LIGHT = "light", DARK = "dark";
        var SUN = "\uf522", MOON = "\uf4ee";

        function getTheme() {
          var saved = localStorage.getItem(STORAGE_KEY);
          var prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)"
          ).matches;
          return saved === LIGHT || saved === DARK
            ? saved
            : prefersDark
              ? DARK
              : LIGHT;
        }

        function applyTheme(t) {
          document.documentElement.setAttribute("data-theme", t);
          localStorage.setItem(STORAGE_KEY, t);
        }

        // Apply immediately on first paint
        applyTheme(getTheme());

        // Re-apply after DOM swap (swapRootAttributes() strips data-theme)
        document.addEventListener("astro:after-swap", function () {
          applyTheme(getTheme());
        });

        // Set up button on every navigation (initial + client-side)
        document.addEventListener("astro:page-load", function () {
          var btn = document.getElementById("theme-toggle");
          if (!btn) return;

          var currentTheme = getTheme();

          function setIcon(t) {
            btn.textContent = t === DARK ? MOON : SUN;
          }

          setIcon(currentTheme);

          btn.onclick = function () {
            var next = currentTheme === DARK ? LIGHT : DARK;
            currentTheme = next;
            applyTheme(next);
            setIcon(next);
          };
          btn.onmouseenter = function () {
            btn.textContent = currentTheme === DARK ? SUN : MOON;
          };
          btn.onmouseleave = function () {
            btn.textContent = currentTheme === DARK ? MOON : SUN;
          };
        });
      })();
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
