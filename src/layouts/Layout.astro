---
import "@/styles/global.css";
import "@/styles/normalize.css";
import { Font } from "astro:assets";

import Header from "@/components/Header.astro";

interface Props {
  title?: string;
}

const { title = "RottenTh's cafe corner" } = Astro.props;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <title>{title}</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <Font cssVariable="--font-noto-serif-sc" />
    <Font cssVariable="--font-source-han-sans-sc" />
    <Font cssVariable="--font-maple-mono" />
    <script is:inline>
      (function () {
        var STORAGE_KEY = "theme-preference";
        var LIGHT = "light", DARK = "dark";
        var SUN = "\uf522", MOON = "\uf4ee";

        var saved = localStorage.getItem(STORAGE_KEY);
        var prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        var theme =
          saved === LIGHT || saved === DARK
            ? saved
            : prefersDark
              ? DARK
              : LIGHT;

        document.documentElement.setAttribute("data-theme", theme);

        document.addEventListener("DOMContentLoaded", function () {
          var btn = document.getElementById("theme-toggle");
          if (!btn) return;

          var currentTheme = theme;

          function setIcon(t) {
            btn.textContent = t === DARK ? MOON : SUN;
          }

          function applyTheme(t) {
            currentTheme = t;
            document.documentElement.setAttribute("data-theme", t);
            localStorage.setItem(STORAGE_KEY, t);
            setIcon(t);
          }

          setIcon(currentTheme);

          btn.addEventListener("mouseenter", function () {
            btn.textContent = currentTheme === DARK ? SUN : MOON;
          });

          btn.addEventListener("mouseleave", function () {
            btn.textContent = currentTheme === DARK ? MOON : SUN;
          });

          btn.addEventListener("click", function () {
            applyTheme(currentTheme === DARK ? LIGHT : DARK);
          });
        });
      })();
    </script>
  </head>
  <body>
    <Header />
    <slot />
  </body>
</html>
