---
import "@/styles/global.css";
import "@/styles/normalize.css";
import Header from "@/components/Header.astro";

interface Props {
  title?: string;
}

const { title = "RottenTh's cafe nest" } = Astro.props;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <title>{title}</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
  </head>
  <body>
    <Header />
    <slot />
  </body>
</html>
