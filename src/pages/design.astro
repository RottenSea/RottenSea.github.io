---
import ArticleHeader from "../components/ArticleHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadSpecimens } from "../utils/specimens";

const groups = loadSpecimens();
---

<BaseLayout title="Design" wide>
  <article>
    <ArticleHeader title="Design" />
    <p class="design-intro" lang="zh">
      这个网站用的设计系统。下面每一块都是设计系统里的一页样张，用的是设计系统自己的样式，跟着右上角的开关切换明暗。组件做好以后也会加在这里。
    </p>

    <specimen-frames>
      {
        groups.map((group) => (
          <section class="specimen-group">
            <h2>{group.name}</h2>
            {group.specimens.map((specimen) => (
              <figure class="specimen">
                <figcaption>
                  <span class="specimen-name">{specimen.name}</span>
                  <span class="specimen-subtitle">{specimen.subtitle}</span>
                </figcaption>
                <iframe src={specimen.src} title={specimen.name} style={{ height: `${specimen.height}px` }} loading="lazy" />
              </figure>
            ))}
          </section>
        ))
      }
    </specimen-frames>
  </article>
</BaseLayout>

<script>
  /** Resizes each set-up frame to its page's current height. */
  const fits = new Map<HTMLIFrameElement, () => void>();

  // The specimen pages read only data-theme, like the site, so each one gets the site's current
  // theme. A theme can break lines differently, so the frame is measured again.
  function syncTheme(frame: HTMLIFrameElement) {
    const root = frame.contentDocument?.documentElement;
    if (root) root.dataset.theme = document.documentElement.dataset.theme ?? "light";
    fits.get(frame)?.();
  }

  // Same-origin pages can be measured, so each iframe grows to its page's height.
  function setUp(frame: HTMLIFrameElement) {
    const doc = frame.contentDocument;
    const win = frame.contentWindow as (Window & typeof globalThis) | null;
    if (!doc || !win || doc.URL === "about:blank") return;
    // The <html> element's own height is the page's content height. scrollHeight would not do:
    // it never reports less than the frame's viewport, so a frame could grow but never shrink.
    // Rounded up, so a fractional height never leaves a 1px scrollbar. The iframe is border-box,
    // so its height also has to include its own borders.
    const fit = () => {
      const borders = frame.offsetHeight - frame.clientHeight;
      const content = Math.ceil(doc.documentElement.getBoundingClientRect().height);
      frame.style.height = `${content + borders}px`;
    };
    fits.set(frame, fit);
    syncTheme(frame);
    // The page grows when its web fonts arrive. The observer catches that and any later reflow,
    // but only while the page is rendered, so the fonts promise covers a hidden tab too.
    doc.fonts.ready.then(fit);
    new win.ResizeObserver(fit).observe(doc.documentElement);
  }

  class SpecimenFrames extends HTMLElement {
    connectedCallback() {
      const frames = [...this.querySelectorAll("iframe")];
      for (const frame of frames) {
        frame.addEventListener("load", () => setUp(frame));
        // A frame that finished loading before this script ran has missed its load event.
        if (frame.contentDocument?.readyState === "complete") setUp(frame);
      }
      new MutationObserver(() => frames.forEach(syncTheme)).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"]
      });
    }
  }

  customElements.define("specimen-frames", SpecimenFrames);
</script>

<style>
  .design-intro {
    margin-bottom: var(--space-xxl);
  }

  specimen-frames {
    display: block;
  }

  .specimen-group {
    display: grid;
    gap: var(--space-xl);
    margin-bottom: var(--space-section);
  }

  .specimen-group h2 {
    font-family: var(--display-sm-family);
    font-size: var(--display-sm-size);
    line-height: var(--display-sm-lh);
    letter-spacing: var(--display-sm-ls);
  }

  .specimen {
    display: grid;
    gap: var(--space-sm);
  }

  figcaption {
    display: grid;
    gap: var(--space-xxs);
  }

  .specimen-name {
    color: var(--text-ink);
    font-family: var(--title-sm-family);
    font-size: var(--title-sm-size);
    font-weight: var(--title-sm-weight);
    line-height: var(--title-sm-lh);
  }

  .specimen-subtitle {
    color: var(--text-muted);
    font-family: var(--caption-family);
    font-size: var(--caption-size);
    line-height: var(--caption-lh);
  }

  iframe {
    border: var(--border-hairline);
    border-radius: var(--radius-lg);
    display: block;
    width: 100%;
  }
</style>
