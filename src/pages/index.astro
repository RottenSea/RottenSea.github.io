---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPosts, postDates, postUrl } from "../utils/posts";

const posts = await getPosts();
---

<BaseLayout>
  <div class="home-intro">
    <h1>The Key of Urala</h1>
    <p lang="zh">欢迎来到 RottenTh 的咖啡角~</p>
  </div>

  <ol class="post-list">
    {
      posts.map((post) => {
        const { published, publishedDate } = postDates(post);
        return (
          <li class="post-card" lang={post.data.lang}>
            <h2 class="post-card-title">
              <a href={postUrl(post)}>{post.data.title}</a>
            </h2>
            <time class="post-card-date" datetime={published}>
              {publishedDate}
            </time>
            {post.data.description && <p>{post.data.description}</p>}
          </li>
        );
      })
    }
  </ol>
</BaseLayout>

<style>
  .home-intro {
    display: grid;
    gap: var(--space-md);
    margin-bottom: var(--space-xxl);
  }

  .post-list {
    display: grid;
    gap: var(--space-xl);
  }

  .post-card {
    display: grid;
    gap: var(--space-xs);
  }

  .post-card-title {
    font-family: var(--display-sm-family);
    font-size: var(--display-sm-size);
    font-weight: var(--display-sm-weight);
    line-height: var(--display-sm-lh);
    letter-spacing: var(--display-sm-ls);
  }

  .post-card-title a {
    color: var(--text-ink);
    text-decoration: none;
  }

  .post-card-title a:hover {
    text-decoration-line: underline;
  }

  .post-card-date {
    color: var(--text-muted);
    font-family: var(--caption-family);
    font-size: var(--caption-size);
    font-weight: var(--caption-weight);
    line-height: var(--caption-lh);
    letter-spacing: var(--caption-ls);
  }
</style>
